# =====================================================================
#  ReRead environment variables
#
#  Copy this file to `.env.local` and fill in the real values.
#  The SAME variables must also be added in the Vercel dashboard under
#  Settings -> Environment Variables, or the live site won't work.
#
#  Never commit .env.local. It is gitignored, and it should stay that way.
# =====================================================================

# ---------------------------------------------------------- Supabase (required)
# supabase.com -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# The service_role key is a MASTER KEY for your database. Server-side only.
# Never paste it into a screenshot, a chat, or any file that gets committed.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------- Razorpay (required)
# razorpay.com -> switch to TEST MODE -> Settings -> API Keys -> Generate Test Key
# Test keys move no real money. Live keys need business KYC.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: set this only if you configure a webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------- Social login (optional)
# A provider's buttons only appear once BOTH of its values are filled in, so
# leaving a pair blank simply hides that option — no broken buttons.
#
# Google:  console.cloud.google.com -> APIs & Services -> Credentials
#          -> Create OAuth client ID -> Web application
#          Authorised redirect URI: https://<your-domain>/api/auth/google/callback
#                              and: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub:  github.com/settings/developers -> New OAuth App
#          Callback URL: https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------------- Sessions
# Signs the login cookie. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is missing the app falls back to a shared development value, which
# means anybody could forge a login — so it MUST be set on Vercel.
SESSION_SECRET=

# ------------------------------------------------------------------- Admin
# The one account allowed to open /admin.
ADMIN_EMAIL=gurkaranlol900@gmail.com

# ------------------------------------------------------------- Web Push (optional)
# Generate a pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
